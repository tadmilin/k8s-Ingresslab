  "term-curl": {
    "file": "term-curl.png",
    "kind": "terminal",
    "label": "curl tests with the host name mapped to the minikube IP",
    "cmds": [
      "$ip = minikube ip; $h = \"--resolve\",\"www.id-624.com:80:$ip\",\"--resolve\",\"admin.id-624.com:80:$ip\"",
      "foreach ($u in 'http://www.id-624.com/','http://www.id-624.com/about','http://www.id-624.com/about/photo.jpg','http://www.id-624.com/research','http://www.id-624.com/api/hello','http://www.id-624.com/api/%E0%B8%AA%E0%B8%A7%E0%B8%B1%E0%B8%AA%E0%B8%94%E0%B8%B5%20K8s','http://www.id-624.com/api/%3Cb%3Ehi%3C%2Fb%3E','http://www.id-624.com/api','http://www.id-624.com/edit','http://admin.id-624.com/','http://admin.id-624.com/edit') { curl.exe -s -o NUL -w \"%{http_code}  %{content_type}  %{size_download}B  $u  %{redirect_url}`n\" @h $u }"
    ],
    "time": "2026-11-19 08:53:29"
  },
  "term-curl-security": {
    "file": "term-curl-security.png",
    "kind": "terminal",
    "label": "HEAD request, security headers, HTML escaping",
    "cmds": [
      "$ip = minikube ip; $h = \"--resolve\",\"www.id-624.com:80:$ip\",\"--resolve\",\"admin.id-624.com:80:$ip\"",
      "curl.exe -sI @h http://www.id-624.com/about",
      "curl.exe -s @h http://www.id-624.com/api/%3Cb%3Ehi%3C%2Fb%3E | sls '<main[^>]*>.*?</main>' | % { $_.Matches.Value }"
    ],
    "time": "2026-11-19 08:53:34"
  },
  "term-lb": {
    "file": "term-lb.png",
    "kind": "terminal",
    "label": "Load balancing: replies per Pod (8 requests each)",
    "cmds": [
      "$ip = minikube ip; $h = \"--resolve\",\"www.id-624.com:80:$ip\",\"--resolve\",\"admin.id-624.com:80:$ip\"",
      "1..8 | % { curl.exe -s @h http://www.id-624.com/about } | sls 'pod (app-[a-z0-9-]+)' | % { $_.Matches[0].Groups[1].Value } | group -NoElement | ft Count,Name -AutoSize",
      "1..8 | % { curl.exe -s @h http://www.id-624.com/research } | sls 'pod (app-[a-z0-9-]+)' | % { $_.Matches[0].Groups[1].Value } | group -NoElement | ft Count,Name -AutoSize",
      "1..8 | % { curl.exe -s @h http://www.id-624.com/api/x } | sls 'pod (app-[a-z0-9-]+)' | % { $_.Matches[0].Groups[1].Value } | group -NoElement | ft Count,Name -AutoSize"
    ],
    "time": "2026-11-19 08:53:37"
  },
