  "term-persist": {
    "file": "term-persist.png",
    "kind": "terminal",
    "label": "Persistence: delete both app-research Pods, the edit stays",
    "cmds": [
      "$ip = minikube ip; $h = \"--resolve\",\"www.id-624.com:80:$ip\",\"--resolve\",\"admin.id-624.com:80:$ip\"",
      "kubectl get pods -n id624 -l app=app-research",
      "kubectl delete pod -n id624 -l app=app-research",
      "kubectl wait -n id624 --for=condition=ready pod -l app=app-research --timeout=120s",
      "kubectl get pods -n id624 -l app=app-research",
      "curl.exe -s @h http://www.id-624.com/research | sls 'admin-edit-\\d+' | % { $_.Matches.Value }"
    ],
    "time": "2026-11-19 08:53:56"
  },
